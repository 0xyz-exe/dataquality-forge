# Application Environment
ENV=development
SECRET_KEY=change-this-in-production-min-32-chars-random
APP_PORT=8000
FRONTEND_PORT=3000

# Database
# Default: SQLite in local data folder
DATABASE_URL=sqlite:///./data/dataquality.db
# PostgreSQL option:
# DATABASE_URL=postgresql+psycopg://dquser:dqpass@localhost:5432/dataquality

# Storage
STORAGE_DIR=./data/storage
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
